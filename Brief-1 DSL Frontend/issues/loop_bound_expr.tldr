# loop_bound_expr.tldr
# Regression test for loop-bound expressions.

f(n : i32) -> [r] {
    r = n
}

main() -> [x] {
    N = 4

    for i in loop((N+1)*2, tile=4) {
        x = i
    }

    for j in loop(-N, unroll=4) {
        x = j
    }

    for k in loop(f(N), tile=4) {
        x = k
    }

    return x
}