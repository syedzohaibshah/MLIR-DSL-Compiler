# bad_softmax_scalar_arg.tldr
# softmax only accepts tensor arguments; here argument 2 is a scalar.
# Expect: [Semantic Error] 'softmax' expects tensor argument(s), but argument 2 is not a tensor

main(){
    A : Tensor[f32, (2,2)] = [[][]] 
    x : f32
    C : Tensor[f32, (2,2)]
    print(softmax(A, x))
    C = softmax(A, A)
}