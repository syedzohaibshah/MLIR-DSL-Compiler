# Llama 3.1 8B - feed-forward gate step using the builtin relu op (a simple
# stand-in for the SwiGLU gate). Dummy data is negative so relu clips to 0.
main() -> [g] {
    a : Tensor[f32, (8, 8, 8)]
    g : Tensor[f32, (8, 8, 8)]
    for i in loop(8) {
        for j in loop(8) {
            for k in loop(8) {
                a[i, j, k] = -1.0
                g[i, j, k] = 0.0
            }
        }
    }
    g = relu(a)
    print(relu(a))
    return g
}
